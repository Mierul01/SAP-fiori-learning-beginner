{
	"_version": "1.58.0",
	"sap.app": {
		"id": "fiori.beginner.products",
		"type": "application",
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"applicationVersion": { "version": "1.0.0" },
		"dataSources": {
			"productsData": {
				"uri": "model/products.json",
				"type": "JSON"
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"deviceTypes": { "desktop": true, "tablet": true, "phone": true }
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "fiori.beginner.products.view.App",
			"type": "XML",
			"id": "app"
		},
		"dependencies": {
			"minUI5Version": "1.148.0",
			"libs": { "sap.m": {}, "sap.ui.layout": {} }
		},
		"resources": {
			"css": [{ "uri": "css/style.css" }]
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": { "bundleName": "fiori.beginner.products.i18n.i18n" }
			},
			"": {
				"type": "sap.ui.model.json.JSONModel",
				"dataSource": "productsData"
			}
		},
		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router",
				"type": "View",
				"viewType": "XML",
				"path": "fiori.beginner.products.view",
				"controlId": "app",
				"controlAggregation": "pages",
				"transition": "slide",
				"async": true
			},
			"routes": [
				{ "name": "list", "pattern": "", "target": "list" },
				{ "name": "detail", "pattern": "product/{productId}", "target": "detail" }
			],
			"targets": {
				"list": { "id": "list", "name": "ProductList", "level": 1 },
				"detail": { "id": "detail", "name": "ProductDetail", "level": 2 }
			}
		}
	}
}
