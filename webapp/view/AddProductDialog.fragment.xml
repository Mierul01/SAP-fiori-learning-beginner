<!--
	A Fragment is a reusable piece of UI without its own controller.
	This one is opened by ProductList.controller.js (onAddProduct).
-->
<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<Dialog
		id="addDialog"
		title="{i18n>addTitle}"
		icon="sap-icon://add-product"
		contentWidth="28rem"
		class="addDialog">
		<!-- A simple stacked form: each field is a label with its control under it -->
		<VBox class="addForm">
			<VBox class="formField">
				<Label text="{i18n>lblName}" required="true" labelFor="newName"/>
				<Input
					id="newName"
					value="{view>/newProduct/Name}"
					valueState="{view>/newProduct/nameState}"
					valueStateText="{i18n>nameRequired}"
					placeholder="{i18n>namePlaceholder}"
					liveChange=".onNewNameChange"/>
			</VBox>

			<VBox class="formField">
				<Label text="{i18n>lblCategory}" labelFor="newCategory"/>
				<Select id="newCategory" selectedKey="{view>/newProduct/Category}" width="100%">
					<core:Item key="Laptops" text="Laptops"/>
					<core:Item key="Monitors" text="Monitors"/>
					<core:Item key="Accessories" text="Accessories"/>
					<core:Item key="Printers" text="Printers"/>
				</Select>
			</VBox>

			<VBox class="formField">
				<Label text="{i18n>lblSupplier}" labelFor="newSupplier"/>
				<Input id="newSupplier" value="{view>/newProduct/Supplier}"/>
			</VBox>

			<!-- Price and quantity side by side: each stepper only needs a short number -->
			<HBox class="formRow">
				<VBox class="formField">
					<Label text="{i18n>lblPriceRm}" labelFor="newPrice"/>
					<StepInput id="newPrice" value="{view>/newProduct/Price}" min="0" max="99999" step="10"
						width="100%" textAlign="Center" class="qtyInput"/>
				</VBox>
				<VBox class="formField">
					<Label text="{i18n>lblQuantity}" labelFor="newStock"/>
					<StepInput id="newStock" value="{view>/newProduct/Stock}" min="0" max="999"
						width="100%" textAlign="Center" class="qtyInput"/>
				</VBox>
			</HBox>

			<VBox class="formField">
				<HBox justifyContent="SpaceBetween" alignItems="Center">
					<Label text="{i18n>lblDescription}" labelFor="newDescription"/>
					<!-- Claude writes the description from the name, category and price -->
					<Button text="{= ${view>/ai/writing} ? ${i18n>aiWriting} : ${i18n>aiWrite} }" icon="sap-icon://ai"
						type="Transparent" press=".onAiDescription" enabled="{= !${view>/ai/writing} }" class="aiWriteBtn"/>
				</HBox>
				<TextArea id="newDescription" value="{view>/newProduct/Description}" rows="3" width="100%"/>
			</VBox>
		</VBox>
		<beginButton>
			<Button text="{i18n>btnSave}" type="Emphasized" press=".onSaveProduct"/>
		</beginButton>
		<endButton>
			<Button text="{i18n>btnCancel}" press=".onCancelAdd"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>
